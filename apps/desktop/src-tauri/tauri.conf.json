{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Splyce",
  "version": "0.1.0",
  "identifier": "org.octokon.splyce",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420" },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Splyce",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' splyce-module:; worker-src 'self' splyce-module:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": { "resources/engine/": "engine/" }
  }
}
