+			},
+			{
+				id: "c",
+				choices: [
+					{
+						index: 0,
+						delta: {
+							tool_calls: [
+								{ index: 1, id: "call_b", type: "function", function: { name: "beta", arguments: '{"b":' } },
+							],
+						},
+						finish_reason: null,
+					},
+				],
+			},
+			{
+				id: "c",
+				choices: [
